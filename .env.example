# Copy this file to .env and fill in real values, then run ./scripts/install.sh
# NEVER commit the filled-in .env (it contains AWS credentials) -- .gitignore
# in this directory already excludes it.

### Cluster target ##########################################################
NAMESPACE=ray-history

### Images ###################################################################
# Defaults below are pre-built images, already
# pushed to a public quay.io repo - no build step required to get started.
# NOTE: quay.io/cathaloconnor is a personal/demo namespace, not an official
# Red Hat registry - fine for a demo/eval, but for anything
# longer-lived, build your own from source (images/build-and-push.sh) and
# push to a registry you control, then update the three *_IMAGE values below.
HISTORYSERVER_IMAGE=quay.io/cathaloconnor/historyserver:v0.1.0
DASHBOARD_IMAGE=quay.io/cathaloconnor/kuberay-dashboard:latest
# Only needed if you pass --with-raycluster to install.sh, or when using
# scripts/patch-existing-raycluster.sh against an existing cluster:
COLLECTOR_IMAGE=quay.io/cathaloconnor/collector:v0.1.0
RAY_IMAGE=quay.io/modh/ray:2.55.1-py312-cu128

### Dashboard base path ######################################################
# Must match the NEXT_PUBLIC_BASE_PATH baked into the dashboard image at
# build time. The pre-built images above were built with
# NEXT_PUBLIC_BASE_PATH=/kuberay-dashboard (the default in build-and-push.sh),
# so this MUST be set to "/kuberay-dashboard" when using them.
#
# To serve the dashboard at "/" on its own Route hostname instead, rebuild
# the image with NEXT_PUBLIC_BASE_PATH="" and set this to "" here.
DASHBOARD_BASE_PATH=/kuberay-dashboard

### S3 backend ###############################################################
# Choose ONE of the two blocks below (AWS S3 is active by default; comment it
# out and uncomment the MinIO block to switch). Both historyserver and the
# collector sidecar read the exact same 6 variables regardless of backend.
#
# This package does NOT deploy a MinIO server -- the MinIO option below is
# only for pointing at a MinIO (or other S3-compatible store) you already
# have running somewhere reachable from the cluster.

# --- Option A: AWS S3 (default) ---------------------------------------------
# Bucket is created automatically on first write if it doesn't already exist
# (the IAM credentials below must allow s3:CreateBucket for that, or
# pre-create the bucket yourself and drop that permission).
S3_BUCKET=ray-history
S3_REGION=us-east-1
S3_ENDPOINT=
S3FORCE_PATH_STYLE=false
S3DISABLE_SSL=false
SSL_CERT_FILE=
# Static IAM user access key/secret, scoped to only S3_BUCKET. See the
# IAM policy example in manifests/01-secret-s3-credentials.yaml.tpl.
# AWS_S3TOKEN (STS session token) is also supported by the app if you use
# temporary credentials instead -- not wired into these templates by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Option B: MinIO / other S3-compatible store (bring your own instance) -
# Uncomment and fill these in instead of Option A above, and comment Option A
# out. S3_REGION can usually be any non-empty placeholder value for MinIO
# (e.g. "us-east-1") -- MinIO mostly ignores it, but the AWS SDK requires it
# to be set to something.
# S3_BUCKET=ray-history-server
# S3_REGION=us-east-1
# S3_ENDPOINT=minio.my-minio-namespace.svc:443         # host:port, no scheme
# S3FORCE_PATH_STYLE=true                              # required for MinIO
# S3DISABLE_SSL=false                                  # true only if MinIO is plain HTTP internally
# SSL_CERT_FILE=/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt  # only if MinIO's TLS cert is internally-signed (e.g. OpenShift service-ca)
# AWS_ACCESS_KEY_ID=      # MinIO access key
# AWS_SECRET_ACCESS_KEY=  # MinIO secret key

S3_SECRET_NAME=ray-history-s3-creds

### OAuth proxy (Route authentication) ######################################
# Both the historyserver and kuberay-dashboard Routes are fronted by an
# OpenShift OAuth proxy sidecar, so only authenticated cluster users can
# access them. CLI access (e.g. curl) works by passing a bearer token:
#   curl -H "Authorization: Bearer $(oc whoami -t)" https://<route>/...
OAUTH_PROXY_IMAGE=registry.redhat.io/openshift4/ose-oauth-proxy-rhel9:v4.17
# Cookie-signing secret for the OAuth proxy session cookie. Auto-generated
# by install.sh if left empty (fine for single-replica deployments). Set
# explicitly and persist in .env for consistency across re-installs.
# OAUTH_COOKIE_SECRET=

### New RayCluster (only used with install.sh --with-raycluster) ###########
RAYCLUSTER_NAME=raycluster-prod
WORKER_REPLICAS=1
WORKER_MIN_REPLICAS=0
WORKER_MAX_REPLICAS=4

### Gateway API HTTPRoute (only used if you rename 04-...example -> 04-...tpl)
GATEWAY_NAME=data-science-gateway
GATEWAY_NAMESPACE=openshift-ingress
